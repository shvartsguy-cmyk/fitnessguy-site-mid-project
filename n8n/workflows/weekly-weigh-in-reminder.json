    {
      "parameters": {
        "jsCode": "// Members with a connected Telegram who have no weigh-in in the last 7 days.\n// Site leads without telegram_id can't receive a Telegram reminder, so they are skipped.\nconst members = $('Get All Members').all().map(i => i.json).filter(m => m.telegram_id);\nconst weighed = new Set($('Get Last 7 Days Weights').all().map(i => String(i.json.telegram_id)));\n\nreturn members\n  .filter(m => !weighed.has(String(m.telegram_id)))\n  .map(m => ({ json: m }));\n"
      },
      "id": "8f3b4a3d-89a9-48b7-b6ff-8700d6553c28",
      "name": "Filter Not Weighed in 7 Days",
      "type": "n8n-nodes-base.code",
