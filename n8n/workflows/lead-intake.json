    {
      "parameters": {
        "jsCode": "// Fills the email templates from n8n/emails/ with the lead's data.\n// Every value is HTML-escaped, so text typed into the site form can't inject markup.\nconst LEAD_TEMPLATE = \"<!DOCTYPE html>\\n<html lang=\\\"he\\\" dir=\\\"rtl\\\">\\n<head>\\n<meta charset=\\\"utf-8\\\">\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\">\\n<meta name=\\\"color-scheme\\\" content=\\\"dark\\\">\\n<meta name=\\\"supported-color-schemes\\\" content=\\\"dark\\\">\\n<title>המסלול שמתאים לכם</title>\\n<link href=\\\"https://fonts.googleapis.com/css2?family=Noto+Sans+Hebrew:wght@900&family=IBM+Plex+Sans+Hebrew:wght@400;600;700&display=swap\\\" rel=\\\"stylesheet\\\">\\n<style>\\nbody { margin: 0; padding: 0; background: #12161a; }\\na { color: #13e3e6; }\\n@media (max-width: 620px) {\\n.card { padding: 28px 20px !important; }\\n.h1 { font-size: 26px !important; }\\n.track { font-size: 24px !important; }\\n}\\n</style>\\n</head>\\n<body style=\\\"margin:0;padding:0;background:#12161a;\\\">\\n<div style=\\\"display:none;max-height:0;overflow:hidden;opacity:0;color:#12161a;\\\">%PREHEADER%</div>\\n<table role=\\\"presentation\\\" dir=\\\"rtl\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\" style=\\\"background:#12161a;\\\">\\n<tr><td align=\\\"center\\\" style=\\\"padding:32px 12px;\\\">\\n<table role=\\\"presentation\\\" dir=\\\"rtl\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\" style=\\\"max-width:600px;\\\">\\n<tr><td align=\\\"center\\\" style=\\\"padding:0 0 20px;\\\">\\n<img src=\\\"https://res.cloudinary.com/dmrksuz8a/image/upload/e_trim/w_68,h_68,c_fit/w_104,h_104,c_pad,b_rgb:eceef0/r_max,bo_3px_solid_rgb:13e3e6/f_png/v1781354090/Gemini_Generated_Image_5xbjy55xbjy55xbjd_azqtnh.png\\\" width=\\\"72\\\" height=\\\"72\\\" alt=\\\"Fitness Guy\\\" style=\\\"display:block;border:0;width:72px;height:72px;\\\">\\n</td></tr>\\n<tr><td class=\\\"card\\\" dir=\\\"rtl\\\" style=\\\"background:#1c2227;border-top:3px solid #13e3e6;padding:36px 36px 32px;text-align:right;\\\">\\n<table role=\\\"presentation\\\" dir=\\\"rtl\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\">\\n<tr>\\n<td width=\\\"76\\\" valign=\\\"middle\\\" style=\\\"padding:0 0 0 16px;\\\">\\n<img src=\\\"https://res.cloudinary.com/dmrksuz8a/image/upload/c_thumb,g_face,w_176,h_176,z_0.75/r_max,bo_4px_solid_rgb:13e3e6/f_png/v1790336253/coach.png\\\" width=\\\"64\\\" height=\\\"64\\\" alt=\\\"המאמן של Fitness Guy\\\" style=\\\"display:block;border:0;width:64px;height:64px;\\\">\\n</td>\\n<td dir=\\\"rtl\\\" valign=\\\"middle\\\" style=\\\"font-family:'IBM Plex Sans Hebrew',Arial,sans-serif;font-size:17px;line-height:1.5;color:#9aa4ac;text-align:right;\\\">\\nהיי %NAME%,\\n</td>\\n</tr>\\n</table>\\n<h1 class=\\\"h1\\\" dir=\\\"rtl\\\" style=\\\"margin:20px 0 24px;font-family:'Noto Sans Hebrew',Arial,sans-serif;font-weight:900;font-size:32px;line-height:1.15;color:#eceef0;text-align:right;\\\">המסלול שלכם מוכן</h1>\\n<table role=\\\"presentation\\\" dir=\\\"rtl\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\">\\n<tr><td dir=\\\"rtl\\\" style=\\\"background:#242c32;border-right:4px solid #13e3e6;padding:20px 22px;text-align:right;\\\">\\n<p style=\\\"margin:0 0 4px;font-family:'IBM Plex Sans Hebrew',Arial,sans-serif;font-size:14px;color:#9aa4ac;\\\">המסלול שמתאים לכם</p>\\n<p class=\\\"track\\\" dir=\\\"ltr\\\" style=\\\"margin:0 0 12px;font-family:'Noto Sans Hebrew',Arial,sans-serif;font-weight:900;font-size:28px;line-height:1.2;color:#13e3e6;text-align:right;\\\">%TRACK%</p>\\n<p style=\\\"margin:0;font-family:'IBM Plex Sans Hebrew',Arial,sans-serif;font-size:16px;line-height:1.7;color:#eceef0;\\\">%WHY%</p>\\n</td></tr>\\n</table>\\n<p style=\\\"margin:32px 0 14px;font-family:'IBM Plex Sans Hebrew',Arial,sans-serif;font-weight:700;font-size:17px;color:#eceef0;\\\">מה קורה עכשיו</p>\\n<table role=\\\"presentation\\\" dir=\\\"rtl\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\">\\n<tr>\\n<td width=\\\"34\\\" valign=\\\"top\\\" style=\\\"font-family:'Noto Sans Hebrew',Arial,sans-serif;font-weight:900;font-size:20px;line-height:1.4;color:#13e3e6;\\\">1</td>\\n<td dir=\\\"rtl\\\" style=\\\"padding:0 0 12px;font-family:'IBM Plex Sans Hebrew',Arial,sans-serif;font-size:16px;line-height:1.6;color:#eceef0;text-align:right;\\\">מתחברים לבוט שלנו בטלגרם, לשאלות, לליווי ולתזכורות שקילה.</td>\\n</tr>\\n<tr>\\n<td width=\\\"34\\\" valign=\\\"top\\\" style=\\\"font-family:'Noto Sans Hebrew',Arial,sans-serif;font-weight:900;font-size:20px;line-height:1.4;color:#13e3e6;\\\">2</td>\\n<td dir=\\\"rtl\\\" style=\\\"padding:0 0 12px;font-family:'IBM Plex Sans Hebrew',Arial,sans-serif;font-size:16px;line-height:1.6;color:#eceef0;text-align:right;\\\">מאמן מהצוות יוצר איתכם קשר.</td>\\n</tr>\\n<tr>\\n<td width=\\\"34\\\" valign=\\\"top\\\" style=\\\"font-family:'Noto Sans Hebrew',Arial,sans-serif;font-weight:900;font-size:20px;line-height:1.4;color:#13e3e6;\\\">3</td>\\n<td dir=\\\"rtl\\\" style=\\\"padding:0;font-family:'IBM Plex Sans Hebrew',Arial,sans-serif;font-size:16px;line-height:1.6;color:#eceef0;text-align:right;\\\">מתחילים בשיחת אפיון, ומשם בונים את התוכנית.</td>\\n</tr>\\n</table>\\n<table role=\\\"presentation\\\" dir=\\\"rtl\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\" style=\\\"margin:32px 0 0;\\\">\\n<tr><td align=\\\"center\\\">\\n<table role=\\\"presentation\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\">\\n<tr><td bgcolor=\\\"#13e3e6\\\" style=\\\"background:#13e3e6;\\\">\\n<a href=\\\"%TG_URL%\\\" style=\\\"display:block;text-decoration:none;\\\">\\n<img src=\\\"https://res.cloudinary.com/dmrksuz8a/image/upload/v1790424114/email-telegram-button.png\\\" width=\\\"340\\\" height=\\\"56\\\" alt=\\\"פתיחת הבוט בטלגרם\\\" style=\\\"display:block;border:0;width:340px;max-width:100%;height:auto;background:#13e3e6;color:#06232b;font-family:Arial,sans-serif;font-weight:700;font-size:17px;line-height:56px;text-align:center;\\\">\\n</a>\\n</td></tr>\\n</table>\\n</td></tr>\\n<tr><td dir=\\\"rtl\\\" align=\\\"center\\\" style=\\\"padding:14px 0 0;font-family:'IBM Plex Sans Hebrew',Arial,sans-serif;font-size:14px;line-height:1.6;color:#9aa4ac;text-align:center;\\\">\\nכשהבוט יבקש, מסרו לו את אותו מספר טלפון שהשארתם באתר, והוא יזהה אתכם.\\n</td></tr>\\n</table>\\n</td></tr>\\n<tr><td dir=\\\"rtl\\\" align=\\\"center\\\" style=\\\"padding:24px 12px 0;font-family:'IBM Plex Sans Hebrew',Arial,sans-serif;font-size:13px;line-height:1.6;color:#6b737b;text-align:center;\\\">\\nקיבלתם את המייל כי מילאתם את טופס ההתאמה באתר שלנו.<br>\\nאם זה לא אתם, אפשר פשוט להתעלם ממנו.\\n</td></tr>\\n</table>\\n</td></tr>\\n</table>\\n</body>\\n</html>\";\nconst TEAM_TEMPLATE = \"<!DOCTYPE html>\\n<html lang=\\\"he\\\" dir=\\\"rtl\\\">\\n<head>\\n<meta charset=\\\"utf-8\\\">\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\">\\n<title>ליד חדש מהאתר</title>\\n<link href=\\\"https://fonts.googleapis.com/css2?family=Noto+Sans+Hebrew:wght@900&family=IBM+Plex+Sans+Hebrew:wght@400;600;700&display=swap\\\" rel=\\\"stylesheet\\\">\\n<style>\\nbody { margin: 0; padding: 0; background: #eef0f2; }\\n@media (max-width: 620px) {\\n.card { padding: 24px 18px !important; }\\n.name { font-size: 24px !important; }\\n.act { display: block !important; width: 100% !important; padding: 0 0 10px !important; }\\n.act a { display: block !important; }\\n}\\n</style>\\n</head>\\n<body style=\\\"margin:0;padding:0;background:#eef0f2;\\\">\\n<div style=\\\"display:none;max-height:0;overflow:hidden;opacity:0;color:#eef0f2;\\\">%PREHEADER%</div>\\n<table role=\\\"presentation\\\" dir=\\\"rtl\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\" style=\\\"background:#eef0f2;\\\">\\n<tr><td align=\\\"center\\\" style=\\\"padding:24px 12px;\\\">\\n<table role=\\\"presentation\\\" dir=\\\"rtl\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\" style=\\\"max-width:600px;\\\">\\n<tr><td dir=\\\"rtl\\\" style=\\\"background:#12161a;border-top:3px solid #13e3e6;padding:14px 20px;\\\">\\n<table role=\\\"presentation\\\" dir=\\\"rtl\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\">\\n<tr>\\n<td width=\\\"48\\\" valign=\\\"middle\\\" style=\\\"padding:0 0 0 12px;\\\">\\n<img src=\\\"https://res.cloudinary.com/dmrksuz8a/image/upload/e_trim/w_50,h_50,c_fit/w_72,h_72,c_pad,b_rgb:eceef0/r_max/f_png/v1781354090/Gemini_Generated_Image_5xbjy55xbjy55xbjd_azqtnh.png\\\" width=\\\"36\\\" height=\\\"36\\\" alt=\\\"Fitness Guy\\\" style=\\\"display:block;border:0;width:36px;height:36px;\\\">\\n</td>\\n<td dir=\\\"rtl\\\" valign=\\\"middle\\\" style=\\\"font-family:'IBM Plex Sans Hebrew',Arial,sans-serif;font-weight:700;font-size:16px;color:#eceef0;text-align:right;\\\">ליד חדש מהאתר</td>\\n<td dir=\\\"ltr\\\" valign=\\\"middle\\\" style=\\\"font-family:'IBM Plex Sans Hebrew',Arial,sans-serif;font-size:13px;color:#9aa4ac;text-align:left;\\\">%TIME%</td>\\n</tr>\\n</table>\\n</td></tr>\\n<tr><td class=\\\"card\\\" dir=\\\"rtl\\\" style=\\\"background:#ffffff;padding:28px 28px 24px;text-align:right;\\\">\\n<p class=\\\"name\\\" style=\\\"margin:0 0 10px;font-family:'Noto Sans Hebrew',Arial,sans-serif;font-weight:900;font-size:28px;line-height:1.2;color:#12161a;\\\">%NAME%</p>\\n<p style=\\\"margin:0 0 22px;font-family:'IBM Plex Sans Hebrew',Arial,sans-serif;font-size:15px;color:#4a5056;\\\">\\n<span dir=\\\"ltr\\\" style=\\\"display:inline-block;background:#06232b;color:#13e3e6;font-weight:700;font-size:14px;padding:5px 12px;\\\">%TRACK%</span>\\n&nbsp;·&nbsp; מטרה: %GOAL%\\n</p>\\n<table role=\\\"presentation\\\" dir=\\\"rtl\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\" style=\\\"border-top:1px solid #dbdfe3;border-bottom:1px solid #dbdfe3;\\\">\\n<tr>\\n<td style=\\\"padding:12px 0;font-family:'IBM Plex Sans Hebrew',Arial,sans-serif;font-size:14px;color:#6b737b;width:70px;\\\">טלפון</td>\\n<td dir=\\\"ltr\\\" style=\\\"padding:12px 0;font-family:'IBM Plex Sans Hebrew',Arial,sans-serif;font-size:16px;color:#12161a;text-align:right;\\\"><a href=\\\"tel:%PHONE%\\\" style=\\\"color:#12161a;text-decoration:none;\\\">%PHONE_DISPLAY%</a></td>\\n</tr>\\n<tr>\\n<td style=\\\"padding:0 0 12px;font-family:'IBM Plex Sans Hebrew',Arial,sans-serif;font-size:14px;color:#6b737b;\\\">אימייל</td>\\n<td dir=\\\"ltr\\\" style=\\\"padding:0 0 12px;font-family:'IBM Plex Sans Hebrew',Arial,sans-serif;font-size:16px;color:#12161a;text-align:right;\\\"><a href=\\\"mailto:%EMAIL%\\\" style=\\\"color:#12161a;text-decoration:none;\\\">%EMAIL%</a></td>\\n</tr>\\n</table>\\n<table role=\\\"presentation\\\" dir=\\\"rtl\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\" style=\\\"margin:18px 0 22px;\\\">\\n<tr>\\n<td class=\\\"act\\\" width=\\\"50%\\\" style=\\\"padding:0 0 0 6px;\\\">\\n<a href=\\\"tel:%PHONE%\\\" style=\\\"display:block;background:#13e3e6;color:#06232b;font-family:'IBM Plex Sans Hebrew',Arial,sans-serif;font-weight:700;font-size:16px;text-decoration:none;padding:14px 10px;text-align:center;\\\">להתקשר</a>\\n</td>\\n<td class=\\\"act\\\" width=\\\"50%\\\" style=\\\"padding:0 6px 0 0;\\\">\\n<a href=\\\"mailto:%EMAIL%?subject=%MAIL_SUBJECT%\\\" style=\\\"display:block;background:#ffffff;border:2px solid #12161a;color:#12161a;font-family:'IBM Plex Sans Hebrew',Arial,sans-serif;font-weight:700;font-size:16px;text-decoration:none;padding:12px 10px;text-align:center;\\\">לשלוח מייל</a>\\n</td>\\n</tr>\\n</table>\\n<table role=\\\"presentation\\\" dir=\\\"rtl\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\">\\n<tr><td dir=\\\"rtl\\\" style=\\\"background:#f4f6f7;border-right:4px solid #0aa9ad;padding:16px 18px;text-align:right;\\\">\\n<p style=\\\"margin:0 0 4px;font-family:'IBM Plex Sans Hebrew',Arial,sans-serif;font-weight:700;font-size:14px;color:#4a5056;\\\">מה העסיק אותו</p>\\n<p style=\\\"margin:0 0 14px;font-family:'IBM Plex Sans Hebrew',Arial,sans-serif;font-size:15px;line-height:1.6;color:#12161a;\\\">%SUMMARY%</p>\\n<p style=\\\"margin:0 0 4px;font-family:'IBM Plex Sans Hebrew',Arial,sans-serif;font-weight:700;font-size:14px;color:#4a5056;\\\">הנימוק שהלקוח קיבל</p>\\n<p style=\\\"margin:0;font-family:'IBM Plex Sans Hebrew',Arial,sans-serif;font-size:15px;line-height:1.6;color:#12161a;\\\">%WHY%</p>\\n</td></tr>\\n</table>\\n<p style=\\\"margin:18px 0 0;font-family:'IBM Plex Sans Hebrew',Arial,sans-serif;font-size:13px;line-height:1.7;color:#6b737b;\\\">\\n%CHAT% &nbsp;·&nbsp; דיוור: %MARKETING%\\n</p>\\n</td></tr>\\n<tr><td dir=\\\"rtl\\\" align=\\\"center\\\" style=\\\"padding:16px 12px 0;font-family:'IBM Plex Sans Hebrew',Arial,sans-serif;font-size:12px;color:#8a9199;text-align:center;\\\">\\nנשלח אוטומטית מטופס ההתאמה באתר. כרטיס הלקוח כבר נשמר במערכת.\\n</td></tr>\\n</table>\\n</td></tr>\\n</table>\\n</body>\\n</html>\";\n\nconst esc = (v) => String(v ?? '').replace(/[&<>\"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' })[c]);\nconst fill = (tpl, data) => tpl.replace(/%([A-Z_]+)%/g, (m, k) => (k in data ? data[k] : m));\n\nconst lead = $('אימות ונרמול').first().json;\nconst result = $('תוצאה').first().json;\nconst cfg = $('הגדרות').first().json;\nconst p = lead.phone;\nconst phoneDisplay = p.length === 10 ? `${p.slice(0, 3)}-${p.slice(3, 6)}-${p.slice(6)}` : p;\n\nconst data = {\n  NAME: esc(lead.name),\n  TRACK: esc(result.track),\n  WHY: esc(result.why),\n  SUMMARY: esc(result.summary),\n  GOAL: esc(lead.goal_label),\n  EMAIL: esc(lead.email),\n  PHONE: esc(p),\n  PHONE_DISPLAY: esc(phoneDisplay),\n  TG_URL: esc(cfg.telegram_url),\n  TIME: $now.setZone('Asia/Jerusalem').toFormat('dd/MM HH:mm'),\n  CHAT: $('הכנת הבקשה').first().json.had_chat ? 'שוחח עם הבוט באתר לפני הטופס' : 'לא שוחח עם הבוט לפני הטופס',\n  MARKETING: lead.marketing ? 'אישר' : 'לא אישר',\n  MAIL_SUBJECT: encodeURIComponent('Fitness Guy: ההתאמה שלך'),\n};\n\nreturn [{ json: {\n  lead_subject: `המסלול שמתאים לכם ב-Fitness Guy: ${result.track}`,\n  lead_html: fill(LEAD_TEMPLATE, { ...data, PREHEADER: esc(`המסלול שמתאים לכם: ${result.track} · הצעד הבא בטלגרם`) }),\n  team_subject: `ליד חדש מהאתר: ${lead.name} · ${result.track}`,\n  team_html: fill(TEAM_TEMPLATE, { ...data, PREHEADER: esc(`${lead.goal_label} · ${phoneDisplay}`) }),\n} }];\n\n"
      },
