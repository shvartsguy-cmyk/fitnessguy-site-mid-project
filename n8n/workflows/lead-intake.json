    {
      "parameters": {
        "jsCode": "// Picks a track by rules taken from knowledge/pricing-expanded.md, where the tracks\n// differ by experience level, and prepares a model prompt for leads who chatted first.\nconst lead = $('אימות ונרמול').first().json;\nconst turns = $input.all().map(i => i.json).filter(t => t.user_message);\nconst transcript = turns.map(t => 'מבקר: ' + t.user_message + '\\nבוט: ' + (t.bot_response || '')).join('\\n\\n');\n\n// Quoted from knowledge/pricing-expanded.md (\"מסלולי השירות ותמחור\").\nconst TRACKS = {\n  'The Foundation': 'מיועד למתאמנים מתחילים. כולל שיחת אפיון של 30 דקות, בניית תוכנית אימון ראשונית מבוססת ביומכניקה, והנחיות תזונה בסיסיות ללא ליווי חודשי שוטף. 450 ש\"ח בתשלום חד-פעמי.',\n  'The Builder': 'מיועד למתאמנים בינוניים העובדים עצמאית. כולל תוכנית אימונים מתקדמת (כגון חלוקת Upper/Lower), תוכנית תזונה, גישה לגיליון מעקב נתונים, ועדכון תוכנית אחת לחודש. תמיכה בהודעות טקסט בלבד. 550 ש\"ח לחודש, ללא התחייבות ארוכת טווח.',\n  'The Plateau Breaker': 'שירות הפרימיום לליווי אישי (1-on-1), המיועד לשבירת תקיעות ולמקסום היפרטרופיה. כולל ניתוח ביומכני שבועי של סרטוני וידאו, פריודיזציה שבועית דינמית, התאמות תזונה בזמן אמת, וזמינות מלאה בשיחות אישיות. 1,200 ש\"ח לחודש, בהתחייבות למינימום 3 חודשים.',\n};\n\n// Beginners start with The Foundation; anyone stuck gets The Plateau Breaker;\n// intermediates who train independently get The Builder.\nconst track = lead.level === 'beginner' ? 'The Foundation'\n  : (lead.level === 'stuck' || lead.goal === 'plateau') ? 'The Plateau Breaker'\n  : 'The Builder';\n\nconst BUILDER_WHY = {\n  mass: 'המסלול הזה מתאים לכם כי אתם כבר מתאמנים ועובדים עצמאית, ובניית מסה נשענת על תוכנית אימונים מתקדמת, תוכנית תזונה ומעקב נתונים, עם עדכון תוכנית כל חודש.',\n  cut: 'המסלול הזה מתאים לכם כי אתם כבר מתאמנים ועובדים עצמאית, וחיטוב נשען על תוכנית תזונה מדויקת ומעקב נתונים, עם עדכון תוכנית כל חודש.',\n  unsure: 'המסלול הזה מתאים לכם כי אתם כבר מתאמנים ועובדים עצמאית: תוכנית אימונים מתקדמת, תוכנית תזונה, גיליון מעקב ועדכון תוכנית כל חודש, בלי התחייבות ארוכה.',\n};\nconst WHY = {\n  'The Foundation': 'המסלול הזה מתאים לכם כי הוא נבנה למתאמנים מתחילים: שיחת אפיון, תוכנית אימון ראשונית מבוססת ביומכניקה והנחיות תזונה בסיסיות, בתשלום חד-פעמי. זו גם הדרך להכיר את שיטת העבודה לפני ליווי מלא.',\n  'The Builder': BUILDER_WHY[lead.goal] || BUILDER_WHY.unsure,\n  'The Plateau Breaker': 'המסלול הזה מתאים לכם כי הוא נבנה בדיוק לשבירת תקיעות: ליווי אישי צמוד, ניתוח ביומכני שבועי של סרטוני הטכניקה, פריודיזציה דינמית והתאמות תזונה בזמן אמת.',\n};\n\nconst prompt = [\n  'אתה יועץ ההתאמה של Fitness Guy. בחר מסלול אחד לליד שמילא את טופס ההתאמה באתר, אחרי שיחה עם הבוט.',\n  'המסלולים (מתוך מאגר הידע):\\n' + Object.entries(TRACKS).map(([n, d]) => `- ${n}: ${d}`).join('\\n'),\n  `מהטופס: מטרה \"${lead.goal_only}\", ניסיון \"${lead.level_label}\". לפי הכללים, ההמלצה היא ${track}.`,\n  'השיחה שלו עם הבוט:\\n' + transcript,\n  [\n    'הוראות:',\n    `- track: ברירת המחדל היא ${track}. שנה רק אם השיחה מראה בבירור שמסלול אחר מתאים יותר (למשל: מספר על תקיעות, על היותו מתחיל, או על צורך בליווי צמוד).`,\n    '- why: משפט או שניים בעברית, בפנייה ללקוח בלשון רבים (\"המסלול הזה מתאים לכם כי...\"), שמתייחסים למה שעלה בשיחה. בלי מחירים ובלי הבטחות לתוצאה.',\n    '- summary: משפט אחד בעברית לצוות, על המטרה ועל מה שהעסיק אותו בשיחה.',\n    '- track חייב להיות בדיוק אחד משלושת השמות, באנגלית ובאותו איות.',\n  ].join('\\n'),\n].join('\\n\\n');\n\nreturn [{ json: {\n  had_chat: turns.length > 0,\n  prompt,\n  track,\n  why: WHY[track],\n  summary: `${lead.goal_label}. לא שוחח עם הבוט לפני הטופס.`,\n} }];\n"
      },
