      "parameters": {
        "jsCode": "// Validates the site form server-side too: the browser checks can be bypassed.\nconst body = $input.first().json.body || {};\nconst clean = (v, max) => String(v ?? '').trim().slice(0, max);\nconst GOALS = { mass: 'עלייה במסת שריר', cut: 'ירידה במשקל וחיטוב', plateau: 'שבירת תקיעות', unsure: 'עדיין לא בטוח' };\nconst LEVELS = { beginner: 'מתחיל', intermediate: 'מתאמן כבר תקופה', stuck: 'מתאמן ותקוע' };\n\nconst lead = {\n  name: clean(body.name, 80),\n  phone: clean(body.phone, 20).replace(/\\D/g, ''),\n  email: clean(body.email, 120).toLowerCase(),\n  goal: clean(body.goal, 20),\n  level: clean(body.level, 20),\n  marketing: body.marketing === true || body.marketing === 'true' || body.marketing === 'on',\n  session_id: clean(body.session_id, 64),\n};\n\nlet error = '';\nif (!lead.name || !lead.phone || !lead.email || !lead.goal || !lead.level) error = 'צריך למלא שם, טלפון, אימייל, מטרה וניסיון.';\nelse if (!/^0\\d{8,9}$/.test(lead.phone)) error = 'מספר הטלפון לא נראה תקין.';\nelse if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(lead.email)) error = 'כתובת האימייל לא נראית תקינה.';\nelse if (!GOALS[lead.goal]) error = 'המטרה שנבחרה לא מוכרת.';\nelse if (!LEVELS[lead.level]) error = 'רמת הניסיון שנבחרה לא מוכרת.';\nelse if (!(body.privacy === true || body.privacy === 'true' || body.privacy === 'on')) error = 'צריך לאשר את מדיניות הפרטיות.';\n\nreturn [{ json: {\n  ...lead,\n  // goal_label feeds the team email's \"מטרה\" line, so it carries the level too\n  goal_label: GOALS[lead.goal] ? `${GOALS[lead.goal]} · ${LEVELS[lead.level] || ''}` : '',\n  goal_only: GOALS[lead.goal] || '',\n  level_label: LEVELS[lead.level] || '',\n  valid: !error,\n  error,\n} }];\n"
      },
