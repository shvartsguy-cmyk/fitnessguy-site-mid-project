    {
      "parameters": {
        "jsonSchemaExample": "{ \"track\": \"The Plateau Breaker\", \"why\": \"משפט או שניים שמסבירים למה המסלול מתאים לו\", \"summary\": \"משפט אחד על מה שהעסיק אותו, לשימוש הצוות\" }"
      },
      "id": "6794f386-da84-45fe-9fc6-4e2ae97e1dcf",
      "name": "מבנה התשובה",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        2080,
        224
      ]
    },
    {
      "parameters": {
        "jsCode": "// One result for all three paths: rules only (no chat), the model (after a chat),\n// or rules as a fallback when the model failed twice.\nconst TRACKS = ['The Foundation', 'The Builder', 'The Plateau Breaker'];\nconst rules = $('הכנת הבקשה').first().json;\nconst input = $input.first().json;\nconst out = input.output && typeof input.output === 'object' ? input.output : null;\n\nlet track = rules.track;\nlet why = rules.why;\nlet summary = rules.summary;\nlet method = 'rules';\n\nif (out) {\n  const modelTrack = TRACKS.find(t => t.toLowerCase() === String(out.track || '').trim().toLowerCase());\n  if (modelTrack && String(out.why || '').trim()) {\n    track = modelTrack;\n    why = String(out.why).trim();\n    summary = String(out.summary || '').trim() || summary;\n    method = 'model';\n  } else {\n    method = 'fallback';\n  }\n} else if (rules.had_chat) {\n  method = 'fallback';\n}\n\nif (method === 'fallback') {\n  summary = `⚠️ ההתאמה נעשתה לפי הכללים כי המודל לא הגיב. כדאי לעבור על שיחת האתר. ${rules.summary}`;\n}\n\nreturn [{ json: {\n  job_id: $('יצירת משימה').first().json.job_id,\n  track,\n  why,\n  summary,\n  method,\n} }];\n"
      },
