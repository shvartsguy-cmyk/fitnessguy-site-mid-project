    {
      "parameters": {
        "jsCode": "// Splits each uploaded knowledge-base markdown file into one chunk per question-and-answer pair.\n// Each chunk is prefixed with \"[document > section]\" so a short answer still carries its topic.\nfunction chunkMarkdown(md, filename) {\n  const lines = md.replace(/\\r\\n/g, '\\n').split('\\n');\n  let title = filename.replace(/\\.md$/, '');\n  let section = '';\n  let buf = [];\n  const out = [];\n\n  const flush = () => {\n    const body = buf.join('\\n').trim();\n    buf = [];\n    if (body.length < 40) return;\n    const q = body.match(/^\\*\\*ש:\\s*(.+?)\\*\\*/);\n    const where = section ? `${title} > ${section}` : title;\n    out.push({\n      text: `[${where}]\\n${body}`,\n      source: filename,\n      section: section || title,\n      question: q ? q[1].trim() : '',\n    });\n  };\n\n  for (const line of lines) {\n    const h = line.match(/^(#{1,6})\\s+(.*)$/);\n    if (h) {\n      flush();\n      if (h[1].length === 1) {\n        title = h[2].replace(/\\s*[–-]\\s*Fitness Guy\\s*$/, '').trim();\n        section = '';\n      } else {\n        section = h[2].trim();\n      }\n      continue;\n    }\n    if (/^-{3,}\\s*$/.test(line)) {\n      flush();\n      section = 'מקורות';\n      continue;\n    }\n    if (line.startsWith('**ש:')) flush();\n    buf.push(line);\n  }\n  flush();\n  return out;\n}\n\nconst results = [];\nconst items = $input.all();\nfor (let i = 0; i < items.length; i++) {\n  const binary = items[i].binary || {};\n  for (const key of Object.keys(binary)) {\n    const buffer = await this.helpers.getBinaryDataBuffer(i, key);\n    for (const chunk of chunkMarkdown(buffer.toString('utf8'), binary[key].fileName || key)) {\n      results.push({ json: chunk });\n    }\n  }\n}\nreturn results;\n"
      },
